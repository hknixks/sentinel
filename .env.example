# SENTINEL Phase 1 uses only PUBLIC Binance Futures market data endpoints,
# so no API key or secret is required to run the data engine.
#
# This file exists so the project's env-var convention is established
# up front. When authenticated endpoints or other secrets are needed in a
# later phase, they will be added here as examples ONLY -- real values
# must never be committed to Git (.env is git-ignored).

# Override the public REST base URL if needed (e.g. testnet).
BINANCE_FAPI_BASE_URL=https://fapi.binance.com

# Override the public WebSocket base URL if needed (e.g. testnet).
BINANCE_FSTREAM_BASE_URL=wss://fstream.binance.com

# Max symbols bundled into a single combined WebSocket connection.
MAX_SYMBOLS_PER_CONNECTION=400

# Reconnect backoff tuning (seconds).
WS_RECONNECT_BASE_DELAY_SECONDS=1.0
WS_RECONNECT_MAX_DELAY_SECONDS=30.0
WS_PING_TIMEOUT_SECONDS=20.0

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
